<resources>
    <style name="Theme.DshPlus" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#9ca8ff</item>
        <item name="android:navigationBarColor">@color/dsh_plus_brand_background</item>
        <item name="android:statusBarColor">@color/dsh_plus_brand_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@drawable/dsh_plus_splash</item>
    </style>
    <style name="Theme.DshPlus.Scanner" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#1A1A1A</item>
        <item name="colorAccent">#1A1A1A</item>
        <item name="android:windowBackground">#F7F7F5</item>
        <item name="android:statusBarColor">#F7F7F5</item>
        <item name="android:navigationBarColor">#F7F7F5</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
