{
  "name": "dsh-plus",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "DSH-Plus plugin, voice and paired remote clients for the official DeepSeek Harness",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./plugins/commander/cordis.patch.yml"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "setup": "node scripts/harness.mjs install",
    "build": "node scripts/harness.mjs build",
    "dev": "node scripts/harness.mjs dev:desktop",
    "start": "node scripts/harness.mjs start:desktop",
    "dev:web": "node scripts/harness.mjs dev:web",
    "start:web": "node scripts/harness.mjs start:web",
    "experience": "node scripts/experience.mjs",
    "typecheck": "node scripts/harness.mjs typecheck",
    "lint": "node scripts/harness.mjs lint",
    "package:dir": "node scripts/harness.mjs package:desktop:dir",
    "package:mac:arm64": "node scripts/harness.mjs package:desktop:mac:arm64",
    "package:mac:x64": "node scripts/harness.mjs package:desktop:mac:x64",
    "package:win:x64": "node scripts/harness.mjs package:desktop:win:x64",
    "check": "node scripts/harness.mjs check",
    "commander": "node plugins/commander/src/cli.mjs",
    "test:commander": "npm --prefix plugins/commander test",
    "test:voice": "node --test plugins/commander/voice/test/*.test.mjs",
    "build:voice": "npm --prefix plugins/commander run build:client",
    "test:link": "npm --prefix plugins/link test",
    "build:plus": "npm --prefix plugins/commander run build:client",
    "build:android": "node scripts/build-link-android.mjs",
    "package:plus:win": "node scripts/desktop/package-windows.mjs"
  }
}
